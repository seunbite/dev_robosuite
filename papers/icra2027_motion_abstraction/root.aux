\@writefile{toc}{\contentsline {paragraph}{\numberline {VI-B.0.a}Human recognition.}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Automatic structural audit of the 20-cue extension. Left: feasible cue counts before and after adding the selected cues; percentages report growth relative to each robot's feasible count in the original 30-cue screen. Right: deterministic structural labels for all 20 generated programs per robot. \emph  {At-risk substitute} means that the a-priori carrier requirement is unavailable; it is not a human-recognition judgment.}}{8}{}\protected@file@percent }
\newlabel{fig:extension20-structural-audit}{{5}{8}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The same two cues rendered on all eight embodiments. Each row fixes the intended cue, exposing how its evidence is retained, rematerialized onto another carrier, or lost as available channels change. Colored traces show carrier trajectories for the six non-Humanoid/Tiago bodies. The first five columns use Gemini-authored Motion Programs for catalog robots; the last three are synthetic morphologies.}}{8}{}\protected@file@percent }
\newlabel{fig:physical-difficulty-grid}{{6}{8}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {VI-B.0.b}Cue-generation richness.}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{\numberline {VI-B.0.c}Morphological collapse on Roomba.}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Four concrete outcomes in the 20-cue extension, shown at the beginning, middle, and end of each clip. Preservation keeps the original carrier and stroke; rematerialization reconstructs the motion on a different body; augmentation adds a second evidential channel. An at-risk substitute remains executable but omits indispensable structure, as in Roomba \texttt  {clap\_applause}. These labels motivate, but do not replace, hard-negative human recognition.}}{9}{}\protected@file@percent }
\newlabel{fig:extension20-failure-examples}{{7}{9}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{\numberline {VI-B.0.d}Qualitative grounding.}{9}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Structural complexity and compositional diversity of matched human- and LLM-authored Motion Programs ($n=30$ cues per row; mean $\pm $ SD). Program length counts top-level primitives. Attributes/program sums all explicitly written positional and named arguments; parser-inserted defaults are excluded. Types/Cue is the mean number of distinct dynamic motion families---oscillation, line, arc, and one-way joint motion---used in one program; static \texttt  {pose} and \texttt  {hold} primitives are excluded.}}{10}{}\protected@file@percent }
\newlabel{tab:nonanthro-human-llm-30}{{II}{10}{}{}{}}

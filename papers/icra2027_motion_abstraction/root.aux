\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces We test eight robot morphologies, ranging from a humanoid (Unitree G1) to a Roomba, along with three novel synthetic morphologies---PaddleClaw, TrilegCrown, and SpineCrab. An LLM (Gemini-2.5-Pro) interprets the attribute set of each morphology and generates motion programs to realize the given gesture cues across these diverse embodiments.}}{6}{}\protected@file@percent }
\newlabel{fig:offtheshelf}{{3}{6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {[Not fixed]} Planned human recognition comparison over the a-priori feasible cues for each robot. Each group contains human-authored and LLM-authored Motion Programs plus joint-space and Cartesian-space baselines; values are provisional placeholders used only to fix the visual design. The parenthesized $n$ is the feasible count in the 90-cue inventory.}}{6}{}\protected@file@percent }
\newlabel{fig:humanoid-attr-bars}{{4}{6}{}{}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Contrastive prompting does not reliably diversify Roomba paths. In the same five-column format as Fig.~\ref {fig:humanlike-qual}, each row requests a target cue distinguishable from a named foil; the overlays still reuse radial strokes and loops across semantic contrasts.}}{6}{}\protected@file@percent }
\newlabel{fig:roomba-contrastive}{{5}{6}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Symbolic reuse sharply reduces output cost. Dense Joint-Space Sequence{} and Cartesian-Space Sequence{} serialization grows with trajectory width and duration, whereas Motion Program{} fields compactly encode repetition, speed, and holds.}}{6}{}\protected@file@percent }
\newlabel{fig:tokens}{{6}{6}{}{}{}}

# VLM / experiment runner
VLM_BACKEND=transformers
VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# HuggingFace cache on /data (avoid home quota on Babel)
HF_HOME=/data/user_data/YOUR_USER/hf_cache

# 32B on 2 GPUs (after install_vlm_transformers.sh + salloc 2 GPUs):
# VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct

# vLLM in-process (needs new NVIDIA driver):
# VLM_BACKEND=local
# VLLM_TENSOR_PARALLEL_SIZE=2

# Gemini (local dev)
# GOOGLE_API_KEY=

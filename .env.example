# VLM / experiment runner (see docs/REMOTE_QWEN_EXPERIMENTS.md)
# Recommended: in-process vLLM (no HTTP server)
VLM_BACKEND=local
VLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90

# Optional: HTTP vLLM server (legacy)
# VLM_BACKEND=vllm
# VLM_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=EMPTY

# Gemini (local dev only)
# GOOGLE_API_KEY=
